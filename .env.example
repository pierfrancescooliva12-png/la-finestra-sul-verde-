# Copia questo file in .env (in locale) o inserisci le variabili su Netlify:
# Site configuration → Environment variables

# Password della pagina /admin (obbligatoria online)
ADMIN_PASSWORD=

# Stripe (https://dashboard.stripe.com/apikeys) — senza, i pagamenti sono in modalità demo
STRIPE_SECRET_KEY=
# Segreto del webhook (Developers → Webhooks → endpoint https://TUO-SITO/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=

# Resend (https://resend.com) — senza, le email vengono solo registrate nel log
RESEND_API_KEY=
EMAIL_FROM="La Finestra sul Verde <prenotazioni@tuodominio.it>"
